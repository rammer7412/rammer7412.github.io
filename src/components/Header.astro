---
import { navigation, site } from '@/data/site';
import { withBase } from '@/utils/paths';
import ThemeToggle from '@/components/ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const writingPaths = ['/writing/', '/posts/', '/notes/', '/labs/', '/problems/', '/privacy/', '/technology/', '/research/', '/archive/']
  .map((path) => withBase(path));

const isActive = (href: string) => {
  const baseHref = withBase(href);
  if (href === '/writing/') return writingPaths.some((path) => currentPath.startsWith(path));
  return href === '/' ? currentPath === baseHref : currentPath.startsWith(baseHref);
};
---

<header class="header">
  <div class="container header-inner">
    <a class="logo" href={withBase('/')} aria-label={`${site.title} 홈`}>
      <span class="logo-mark">R</span>
      <span class="logo-copy">
        <strong>{site.title}</strong>
        <small>Privacy · Technology · Research</small>
      </span>
    </a>

    <nav class="nav" aria-label="주요 메뉴">
      {navigation.map((item) => (
        <a class:list={[{ active: isActive(item.href) }]} href={withBase(item.href)}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-button search-button" type="button" data-command-open aria-label="검색 열기" title="검색 (Ctrl/⌘ + K)">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.6-3.6" />
        </svg>
      </button>
      <ThemeToggle />
      <a class="github-button" href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub 열기">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.589 2 12.253c0 4.536 2.865 8.38 6.839 9.739.5.094.683-.222.683-.494 0-.244-.009-.89-.014-1.747-2.782.62-3.369-1.375-3.369-1.375-.455-1.185-1.11-1.5-1.11-1.5-.908-.637.069-.624.069-.624 1.004.073 1.532 1.057 1.532 1.057.892 1.567 2.341 1.115 2.91.853.091-.662.35-1.115.636-1.371-2.221-.259-4.555-1.139-4.555-5.066 0-1.119.39-2.034 1.03-2.751-.103-.26-.446-1.303.098-2.715 0 0 .84-.276 2.75 1.05A9.386 9.386 0 0 1 12 6.963c.85.004 1.705.118 2.504.346 1.909-1.326 2.747-1.05 2.747-1.05.546 1.412.203 2.455.1 2.715.641.717 1.028 1.632 1.028 2.751 0 3.937-2.337 4.804-4.566 5.058.359.317.679.944.679 1.902 0 1.373-.013 2.481-.013 2.818 0 .274.18.593.688.493C19.138 20.63 22 16.787 22 12.253 22 6.589 17.523 2 12 2Z" />
        </svg>
        <span>GitHub</span>
      </a>
      <details class="mobile-menu">
        <summary aria-label="모바일 메뉴 열기">
          <span></span><span></span><span></span>
        </summary>
        <nav aria-label="모바일 메뉴">
          {navigation.map((item) => <a class:list={[{ active: isActive(item.href) }]} href={withBase(item.href)}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
