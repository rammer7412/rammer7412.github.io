<button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="화면 테마 전환" title="화면 테마 전환">
  <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z" />
  </svg>
</button>

<script is:inline>
  const themeButton = document.querySelector('[data-theme-toggle]');
  const root = document.documentElement;
  const applyTheme = (theme) => {
    root.dataset.theme = theme;
    localStorage.setItem('rammer-theme', theme);
  };
  themeButton?.addEventListener('click', () => {
    applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
  });
</script>
