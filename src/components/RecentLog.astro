---
import { withBase } from '@/utils/paths';
interface Post {
  slug: string;
  frontmatter: {
    title: string;
    date: string;
    category: string;
    tags?: string[];
  };
}
const { posts = [] } = Astro.props as { posts: Post[] };
const displayPosts = posts.slice(0, 5);
---
<section class="section">
  <div class="container">
    <div class="section-title">
      <div>
        <span class="badge">Recently Updated</span>
        <h2>최근 업데이트 로그</h2>
      </div>
      <a class="ghost-button" href={withBase('/notes/')}>전체 글 보기</a>
    </div>
    <div class="recent-log glass">
      {displayPosts.map((post) => (
        <a class="recent-row" href={withBase(`/posts/${post.slug}/`)}>
          <span class="recent-date">{post.frontmatter.date}</span>
          <span class="recent-category">[{post.frontmatter.category}]</span>
          <span class="recent-title">{post.frontmatter.title}</span>
          <span class="recent-tags">{(post.frontmatter.tags ?? []).slice(0, 2).map((tag) => `#${tag}`).join(' ')}</span>
        </a>
      ))}
    </div>
  </div>
</section>
