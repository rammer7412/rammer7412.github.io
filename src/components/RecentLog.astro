---
import { domainMeta, formatMeta } from '@/data/site';
import { normalizeDomain, normalizeFormat, type PostSummary } from '@/utils/posts';
import { withBase } from '@/utils/paths';

const { posts = [] } = Astro.props as { posts: PostSummary[] };
const displayPosts = posts.slice(0, 6);
---
<section class="section">
  <div class="container">
    <div class="section-heading split-heading">
      <div>
        <span class="eyebrow">LATEST WRITING</span>
        <h2>최근 기록</h2>
      </div>
      <a class="text-link" href={withBase('/archive/')}>모든 글 보기 <span>→</span></a>
    </div>
    <div class="editorial-list">
      {displayPosts.map((post, index) => {
        const domain = normalizeDomain(post.frontmatter);
        const format = normalizeFormat(post.frontmatter);
        return (
          <a class="editorial-row" href={withBase(`/posts/${post.slug}/`)}>
            <span class="editorial-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="editorial-content">
              <div class="post-kicker">
                <span>{domainMeta[domain]?.short ?? post.frontmatter.category}</span>
                <span>{formatMeta[format] ?? format}</span>
              </div>
              <h3>{post.frontmatter.title}</h3>
              <p>{post.frontmatter.description}</p>
            </div>
            <time datetime={post.frontmatter.date}>{post.frontmatter.date}</time>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
