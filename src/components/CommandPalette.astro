---
import { navigation, site } from '@/data/site';
import { getAllPosts, normalizeDomain, normalizeFormat } from '@/utils/posts';
import { domainMeta, formatMeta } from '@/data/site';
import { withBase } from '@/utils/paths';
import { getCollection } from 'astro:content';

const posts = getAllPosts();
const journalEntries = (await getCollection('journal'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const courseEntries = (await getCollection('courses'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ko'));
const lectureEntries = (await getCollection('lectures'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const pageCommands = [
  ...navigation.map((item) => ({ title: item.label, subtitle: '페이지', href: item.href })),
  { title: 'Privacy Notice', subtitle: '쿠키 및 외부 서비스 안내', href: '/site-privacy/' },
  { title: 'GitHub', subtitle: site.github, href: site.github, external: true }
];

const journalCommands = journalEntries.map((item) => ({
  title: item.data.title,
  subtitle: `Journal · ${item.data.category}`,
  href: `/journal/${item.id}/`,
  search: `${item.data.title} ${item.data.description} ${item.data.category} ${item.data.location ?? ''}`
}));

const courseCommands = courseEntries.map((item) => ({
  title: item.data.title,
  subtitle: 'Lecture course',
  href: `/lectures/${item.id}/`,
  search: `${item.data.title} ${item.data.description}`
}));

const lectureCommands = lectureEntries.map((item) => ({
  title: item.data.title,
  subtitle: `${item.data.course} · Lecture ${String(item.data.lectureNumber).padStart(2, '0')}`,
  href: `/lectures/${item.data.courseSlug}/${item.id}/`,
  search: `${item.data.title} ${item.data.description} ${item.data.course} ${(item.data.topics ?? []).join(' ')}`
}));

const postCommands = posts.map((post) => {
  const domain = normalizeDomain(post.frontmatter);
  const format = normalizeFormat(post.frontmatter);
  return {
    title: post.frontmatter.title,
    subtitle: `${domainMeta[domain]?.label === post.frontmatter.category ? post.frontmatter.category : `${domainMeta[domain]?.label ?? 'Writing'} · ${post.frontmatter.category}`} · ${formatMeta[format] ?? format}`,
    href: `/posts/${post.slug}/`,
    search: `${post.frontmatter.title} ${post.frontmatter.description} ${post.frontmatter.category} ${(post.frontmatter.tags ?? []).join(' ')}`
  };
});
---

<div class="command-backdrop" data-command-backdrop aria-hidden="true">
  <div class="command-modal" role="dialog" aria-modal="true" aria-label="사이트 검색">
    <div class="command-input-wrap">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.6-3.6" />
      </svg>
      <input class="command-input" data-command-input placeholder="글 제목, 설명, 태그 검색..." />
      <kbd>ESC</kbd>
    </div>
    <div class="command-list" data-command-list>
      <p class="command-group-label">Pages</p>
      {pageCommands.map((item) => (
        <a class="command-item" href={item.external ? item.href : withBase(item.href)} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined} data-command-item data-title={`${item.title} ${item.subtitle}`.toLowerCase()}>
          <span><strong>{item.title}</strong><small>{item.subtitle}</small></span><span>→</span>
        </a>
      ))}
      {postCommands.length > 0 && <p class="command-group-label">Posts</p>}
      {postCommands.map((item) => (
        <a class="command-item" href={withBase(item.href)} data-command-item data-title={`${item.search} ${item.subtitle}`.toLowerCase()}>
          <span><strong>{item.title}</strong><small>{item.subtitle}</small></span><span>→</span>
        </a>
      ))}
      {(courseCommands.length > 0 || lectureCommands.length > 0) && <p class="command-group-label">Lectures</p>}
      {courseCommands.map((item) => (
        <a class="command-item" href={withBase(item.href)} data-command-item data-title={`${item.search} ${item.subtitle}`.toLowerCase()}>
          <span><strong>{item.title}</strong><small>{item.subtitle}</small></span><span>→</span>
        </a>
      ))}
      {lectureCommands.map((item) => (
        <a class="command-item" href={withBase(item.href)} data-command-item data-title={`${item.search} ${item.subtitle}`.toLowerCase()}>
          <span><strong>{item.title}</strong><small>{item.subtitle}</small></span><span>→</span>
        </a>
      ))}
      {journalCommands.length > 0 && <p class="command-group-label">Journal</p>}
      {journalCommands.map((item) => (
        <a class="command-item" href={withBase(item.href)} data-command-item data-title={`${item.search} ${item.subtitle}`.toLowerCase()}>
          <span><strong>{item.title}</strong><small>{item.subtitle}</small></span><span>→</span>
        </a>
      ))}
      <p class="command-empty" data-command-empty hidden>검색 결과가 없습니다.</p>
    </div>
  </div>
</div>

<script is:inline>
  const backdrop = document.querySelector('[data-command-backdrop]');
  const input = document.querySelector('[data-command-input]');
  const openButtons = document.querySelectorAll('[data-command-open]');
  const items = Array.from(document.querySelectorAll('[data-command-item]'));
  const empty = document.querySelector('[data-command-empty]');

  const open = () => {
    backdrop?.setAttribute('data-open', 'true');
    backdrop?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 0);
  };

  const close = () => {
    backdrop?.setAttribute('data-open', 'false');
    backdrop?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (input) input.value = '';
    items.forEach((item) => item.style.display = 'flex');
    if (empty) empty.hidden = true;
  };

  openButtons.forEach((btn) => btn.addEventListener('click', open));
  backdrop?.addEventListener('click', (event) => {
    if (event.target === backdrop) close();
  });

  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      open();
    }
    if (event.key === 'Escape') close();
  });

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const target = item.getAttribute('data-title') || '';
      const matched = target.includes(query);
      item.style.display = matched ? 'flex' : 'none';
      if (matched) visible += 1;
    });
    if (empty) empty.hidden = visible !== 0;
  });
</script>
