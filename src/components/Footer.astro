---
import { navigation, site } from '@/data/site';
import { withBase } from '@/utils/paths';
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>{site.title}</strong>
      <p>개인정보보호와 기술을 함께 공부하며, 이해한 과정과 직접 분석한 내용을 기록합니다.</p>
    </div>
    <nav aria-label="하단 메뉴">
      <strong>Explore</strong>
      {navigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>
    <nav aria-label="정보 메뉴">
      <strong>Information</strong>
      <a href={withBase('/site-privacy/')}>Privacy Notice</a>
      <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${site.email}`}>Contact</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.title}</span>
    <span>Privacy · Security · Systems · Research</span>
  </div>
</footer>
