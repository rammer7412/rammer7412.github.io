---
import { categories } from '@/data/site';
import { withBase } from '@/utils/paths';
---
<section class="section">
  <div class="container">
    <div class="section-heading split-heading">
      <div>
        <span class="eyebrow">EXPLORE TOPICS</span>
        <h2>공부의 영역</h2>
      </div>
      <p>개인정보보호를 중심에 두되, 이를 실제로 이해하고 구현하는 데 필요한 컴퓨터공학 기반도 함께 축적합니다.</p>
    </div>
    <div class="topic-grid">
      {categories.map((category, index) => (
        <a class="topic-card" href={withBase(category.href)}>
          <div class="topic-card-top">
            <span class="topic-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="topic-label">{category.label}</span>
          </div>
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          <div class="topic-tags">
            {category.topics.map((topic) => <span>{topic}</span>)}
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>
