---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllPosts, normalizeDomain, normalizeFormat } from '@/utils/posts';
import { withBase } from '@/utils/paths';

const projects = getAllPosts().filter((post) =>
  normalizeDomain(post.frontmatter) === 'project' || normalizeFormat(post.frontmatter) === 'project'
);

const statusLabel: Record<string, string> = {
  planned: 'PLANNED',
  'in-progress': 'IN PROGRESS',
  completed: 'COMPLETED',
  paused: 'PAUSED'
};
---
<BaseLayout title="Projects" description="직접 진행한 프로젝트의 목표, 설계, 구현 과정과 회고를 기록합니다.">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">PROJECTS & PRACTICE</span>
        <h1>Projects</h1>
      </div>
      <p>프로젝트가 시작되면 문제 정의, 설계, 구현 과정, 개인정보·보안 고려사항과 회고를 하나의 상세 글로 정리합니다.</p>
    </div>
  </section>

  <section class="section project-section">
    <div class="container">
      {projects.length === 0 ? (
        <div class="empty-state standalone project-empty-state">
          <span>NO PUBLIC PROJECTS YET</span>
          <h2>현재 공개된 프로젝트가 없습니다.</h2>
          <p>새로운 프로젝트를 시작하면 이곳에 카드가 추가되며, 각 카드를 눌러 목표와 진행 과정, 구현 내용과 회고를 블로그 글처럼 확인할 수 있습니다.</p>
        </div>
      ) : (
        <div class="project-list-grid">
          {projects.map((project, index) => (
            <a class="project-entry-card" href={withBase(`/posts/${project.slug}/`)}>
              <div class="project-entry-topline">
                <span class:list={['project-status', { muted: project.frontmatter.status !== 'in-progress' }]}>
                  {project.frontmatter.status === 'in-progress' && <i aria-hidden="true"></i>}
                  {statusLabel[project.frontmatter.status ?? 'planned'] ?? 'PROJECT'}
                </span>
                <span class="project-entry-number">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h2>{project.frontmatter.title}</h2>
              <p>{project.frontmatter.description}</p>
              <div class="project-entry-meta">
                <time datetime={project.frontmatter.date}>{project.frontmatter.date}</time>
                <span>상세 기록 보기 →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
