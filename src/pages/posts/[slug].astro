---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { domainMeta, formatMeta } from '@/data/site';
import { normalizeDomain, normalizeFormat } from '@/utils/posts';
import { withBase } from '@/utils/paths';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/posts/*.md');
  const paths = [];

  for (const [path, load] of Object.entries(modules)) {
    const mod: any = await load();
    if (mod.frontmatter?.draft) continue;

    paths.push({
      params: { slug: path.split('/').pop()?.replace('.md', '') },
      props: { post: mod }
    });
  }

  return paths;
}

const { post } = Astro.props as any;
const { frontmatter } = post;
const Content = post.default;
const domain = normalizeDomain(frontmatter);
const format = normalizeFormat(frontmatter);
const raw = typeof post.rawContent === 'function' ? post.rawContent() : '';
const wordCount = raw.replace(/---[\s\S]*?---/, '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 300));
const backHref = domainMeta[domain]?.href ?? '/writing/';
const isAnalysis = ['case-analysis', 'paper-review', 'report-review', 'opinion'].includes(format);
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image ?? '/og-image.png'}
  type="article"
>
  <article class="article-page">
    <header class="article-header">
      <div class="container article-header-inner">
        <a class="article-back" href={withBase(backHref)}>← {domainMeta[domain]?.label ?? 'Writing'}</a>
        <div class="article-taxonomy">
          <span>{domainMeta[domain]?.label ?? frontmatter.category}</span>
          <span>{formatMeta[format] ?? format}</span>
        </div>
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
        <div class="article-byline">
          <time datetime={frontmatter.date}>{frontmatter.date}</time>
          {frontmatter.updated && <span>수정 {frontmatter.updated}</span>}
          <span>{readingMinutes}분 읽기</span>
          <span>{frontmatter.category}</span>
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <main class="article-body">
        {isAnalysis && (
          <aside class="analysis-notice">
            이 글은 공개 자료와 개인적인 학습을 바탕으로 작성한 분석입니다. 공식 감사, 법률 자문 또는 해당 조직의 공식 입장을 의미하지 않습니다.
          </aside>
        )}
        <div class="article-content"><Content /></div>
      </main>

      <aside class="article-sidebar">
        <div class="sidebar-block">
          <span class="sidebar-label">ABOUT THIS NOTE</span>
          <dl>
            <div><dt>주제</dt><dd>{domainMeta[domain]?.label ?? frontmatter.category}</dd></div>
            <div><dt>형식</dt><dd>{formatMeta[format] ?? format}</dd></div>
            <div><dt>작성</dt><dd>{frontmatter.date}</dd></div>
          </dl>
        </div>
        {(frontmatter.tags ?? []).length > 0 && (
          <div class="sidebar-block">
            <span class="sidebar-label">TAGS</span>
            <div class="sidebar-tags">
              {(frontmatter.tags ?? []).map((tag: string) => <a href={withBase(`/writing/?tag=${encodeURIComponent(tag)}`)}>#{tag}</a>)}
            </div>
          </div>
        )}
        <a class="sidebar-archive-link" href={withBase('/writing/')}>전체 글 보기 <span>→</span></a>
      </aside>
    </div>
  </article>
</BaseLayout>
