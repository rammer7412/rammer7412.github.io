---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import { getAllPosts, normalizeDomain, normalizeFormat } from '@/utils/posts';

const researchFormats = ['paper-review', 'report-review', 'case-analysis', 'opinion'];
const posts = getAllPosts().filter((post) => normalizeDomain(post.frontmatter) === 'research-cases' || researchFormats.includes(normalizeFormat(post.frontmatter)));
---
<BaseLayout title="리서치" description="논문과 보고서를 읽고, 기업과 서비스의 개인정보보호 체계를 분석한 견해를 기록합니다.">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">RESEARCH & CASE STUDY</span>
        <h1>리서치</h1>
      </div>
      <p>자료의 요약에서 멈추지 않고 연구 질문, 근거, 한계와 실무 적용 가능성을 검토합니다. 공개 자료를 바탕으로 기업과 서비스의 보호체계도 분석합니다.</p>
    </div>
  </section>
  <section class="container archive-section">
    {posts.length > 0 ? (
      <PostArchive posts={posts} showDomainFilters={false} />
    ) : (
      <div class="empty-state standalone">
        <span>RESEARCH QUEUE</span>
        <h2>첫 리서치 글을 준비하고 있습니다.</h2>
        <p>논문 리뷰, 정책·산업 보고서 리뷰, 기업 개인정보처리방침과 보호체계 분석을 이곳에 모읍니다.</p>
      </div>
    )}
  </section>
</BaseLayout>
