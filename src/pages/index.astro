---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PerspectiveSection from '@/components/PerspectiveSection.astro';
import CategoryGrid from '@/components/CategoryGrid.astro';
import FeaturedPosts from '@/components/FeaturedPosts.astro';
import RecentLog from '@/components/RecentLog.astro';
import KnowledgeMap from '@/components/KnowledgeMap.astro';
import MistakeArchive from '@/components/MistakeArchive.astro';
import { getAllPosts } from '@/utils/posts';
import { site } from '@/data/site';

const posts = getAllPosts();
---
<BaseLayout title={site.title} description={site.description}>
  <Hero />
  <PerspectiveSection />
  <FeaturedPosts posts={posts} />
  <CategoryGrid />
  <RecentLog posts={posts} />
  <KnowledgeMap />
  <MistakeArchive />
</BaseLayout>
