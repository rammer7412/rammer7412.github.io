---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import { getAllPosts, normalizeDomain } from '@/utils/posts';

const posts = getAllPosts().filter((post) => ['privacy-governance', 'privacy-engineering'].includes(normalizeDomain(post.frontmatter)));
---
<BaseLayout title="개인정보보호" description="개인정보보호 원칙, 거버넌스와 프라이버시 엔지니어링을 기술 구현과 연결해 정리합니다.">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">PRIVACY & GOVERNANCE</span>
        <h1>개인정보보호</h1>
      </div>
      <p>개인정보 생명주기, 정보주체 권리, 법·정책과 조직의 관리체계를 살펴보고, 이를 실제 서비스와 기술 설계에 연결합니다.</p>
    </div>
  </section>
  <section class="container archive-section">
    {posts.length > 0 ? (
      <PostArchive posts={posts} emptyTitle="조건에 맞는 글이 없습니다." />
    ) : (
      <div class="empty-state standalone">
        <span>BUILDING THE ARCHIVE</span>
        <h2>개인정보보호 글을 준비하고 있습니다.</h2>
        <p>개인정보 생명주기, Privacy by Design, 보호체계와 기업 사례 분석을 차례로 정리할 예정입니다.</p>
      </div>
    )}
  </section>
</BaseLayout>
