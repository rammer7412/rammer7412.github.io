---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import { getAllPosts } from '@/utils/posts';
import { formatMeta } from '@/data/site';

const posts = getAllPosts();
const writingDomains = ['data-privacy', 'linear-algebra', 'probability-theory', 'discrete-mathematics', 'number-theory', 'digital-forensics', 'theory-of-computation', 'operating-systems', 'artificial-intelligence'];
const writingFormats = Object.keys(formatMeta);
---
<BaseLayout title="Writing" description="개인정보보호, 선형대수학, 확률 이론, 이산수학, 정수론, 디지털포렌식, 계산이론, 운영체제와 인공지능을 중심으로 새롭게 작성한 글을 탐색합니다.">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">NOTES · ANALYSIS · RESEARCH</span>
        <h1>Writing</h1>
      </div>
      <p>개인정보보호, 선형대수학, 확률 이론, 이산수학, 정수론, 디지털포렌식, 계산이론, 운영체제와 인공지능을 공부하며 새롭게 작성한 글을 모을 공간입니다. 주제와 글 형식으로 분류하거나 제목, 설명, 태그를 검색할 수 있습니다.</p>
    </div>
  </section>
  <section class="container archive-section">
    <PostArchive
      posts={posts}
      domainFilters={writingDomains}
      formatFilters={writingFormats}
      emptyTitle="아직 공개된 글이 없습니다."
      emptyDescription="새로운 글을 준비하고 있습니다."
    />
  </section>
</BaseLayout>
