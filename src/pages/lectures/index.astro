---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/utils/paths';

const courses = (await getCollection('courses'))
  .filter((course) => !course.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ko'));

const lectures = (await getCollection('lectures')).filter((lecture) => !lecture.data.draft);

const courseCards = courses.map((course) => {
  const materials = lectures
    .filter((lecture) => lecture.data.courseSlug === course.id)
    .sort((a, b) => a.data.lectureNumber - b.data.lectureNumber);

  return {
    course,
    materialCount: materials.length
  };
});
---

<BaseLayout title="Lectures" description="직접 진행한 강의를 과정별로 살펴보고, 각 과정의 PDF 강의자료를 열람할 수 있습니다.">
  <section class="page-hero lecture-page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">COURSES · MATERIALS · PDF</span>
        <h1>Lectures</h1>
      </div>
      <p>직접 진행한 강의를 과정별로 정리한 공간입니다. 강의 과정을 선택하면 차시별 자료를 살펴보고 PDF 페이지를 순서대로 내려보며 읽을 수 있습니다.</p>
    </div>
  </section>

  <section class="section lecture-section">
    <div class="container">
      <div class="lecture-section-heading">
        <div>
          <span class="eyebrow">COURSE ARCHIVE</span>
          <h2>강의 과정</h2>
        </div>
        <p>{courseCards.length} course{courseCards.length === 1 ? '' : 's'}</p>
      </div>

      {courseCards.length === 0 ? (
        <div class="empty-state standalone lecture-empty-state">
          <span>NO PUBLIC COURSES YET</span>
          <h2>아직 공개된 강의 과정이 없습니다.</h2>
          <p>강의 과정을 추가하면 과정 정보로 자동 표지가 생성되고 카드 형태로 표시됩니다.</p>
        </div>
      ) : (
        <div class="lecture-grid course-grid">
          {courseCards.map(({ course, materialCount }) => (
            <a class="lecture-card course-card" href={withBase(`/lectures/${course.id}/`)}>
              <div class:list={['lecture-cover', 'course-cover', `lecture-theme-${course.data.theme}`]}>
                <div class="lecture-cover-topline">
                  <span>RAMMER LAB · COURSE</span>
                  <strong>{String(materialCount).padStart(2, '0')}</strong>
                </div>
                <div class="lecture-cover-main">
                  <span>LECTURE ARCHIVE</span>
                  <h2>{course.data.title}</h2>
                </div>
                <div class="lecture-cover-bottomline">
                  <span>{materialCount} MATERIAL{materialCount === 1 ? '' : 'S'}</span>
                  <span>{materialCount > 0 ? 'OPEN COURSE' : 'PREPARING'}</span>
                </div>
              </div>
              <div class="lecture-card-body course-card-body">
                <div class="lecture-card-meta">
                  <span>COURSE</span>
                  <span>{materialCount} material{materialCount === 1 ? '' : 's'}</span>
                </div>
                <h3>{course.data.title}</h3>
                <p>{course.data.description}</p>
                <div class="lecture-card-footer course-card-footer">
                  <strong>{materialCount > 0 ? '강의 들어가기 →' : '자료 준비 중 →'}</strong>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
