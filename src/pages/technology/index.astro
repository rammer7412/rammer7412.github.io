---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import { getAllPosts, normalizeDomain } from '@/utils/posts';

const techDomains = ['security-forensics', 'systems-development', 'cryptography-math'];
const posts = getAllPosts().filter((post) => techDomains.includes(normalizeDomain(post.frontmatter)));
---
<BaseLayout title="기술" description="시스템, 개발, 보안, 디지털포렌식, 암호수학의 기술 기반을 정리합니다.">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">TECHNOLOGY FOUNDATION</span>
        <h1>기술</h1>
      </div>
      <p>개인정보가 처리되는 시스템을 제대로 이해하기 위해 운영체제, 프로그래밍, 보안, 포렌식과 암호수학을 깊이 있게 공부합니다.</p>
    </div>
  </section>
  <section class="container archive-section">
    <PostArchive posts={posts} />
  </section>
</BaseLayout>
