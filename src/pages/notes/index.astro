---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import { getAllPosts, normalizeFormat } from '@/utils/posts';

const posts = getAllPosts().filter((post) => normalizeFormat(post.frontmatter) === 'study-note');
---
<BaseLayout title="학습 노트" description="개념을 이해한 과정과 핵심 내용을 정리한 학습 노트입니다.">
  <section class="page-hero compact">
    <div class="container page-hero-grid">
      <div><span class="eyebrow">LEGACY COLLECTION</span><h1>학습 노트</h1></div>
      <p>기존 주소를 유지하기 위한 학습 노트 모음입니다. 전체 글은 Writing에서 주제와 형식별로 탐색할 수 있습니다.</p>
    </div>
  </section>
  <section class="container archive-section"><PostArchive posts={posts} /></section>
</BaseLayout>
