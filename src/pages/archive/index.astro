---
import { withBase } from '@/utils/paths';
const target = withBase('/writing/');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Writing으로 이동 | Rammer Lab</title>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </head>
  <body>
    <p>글 모음은 <a href={target}>Writing</a>으로 통합되었습니다.</p>
  </body>
</html>
