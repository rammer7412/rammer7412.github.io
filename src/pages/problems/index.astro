---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import { getAllPosts, normalizeFormat } from '@/utils/posts';

const posts = getAllPosts().filter((post) => normalizeFormat(post.frontmatter) === 'problem-solving');
---
<BaseLayout title="문제 풀이" description="알고리즘과 수학 문제의 해결 과정과 판단 근거를 정리합니다.">
  <section class="page-hero compact">
    <div class="container page-hero-grid">
      <div><span class="eyebrow">PROBLEM SOLVING</span><h1>문제 풀이</h1></div>
      <p>정답 코드만 남기지 않고 문제를 어떻게 모델링하고, 조건을 어떻게 검증했는지 사고 과정을 중심으로 기록합니다.</p>
    </div>
  </section>
  <section class="container archive-section"><PostArchive posts={posts} showFormatFilters={false} /></section>
</BaseLayout>
