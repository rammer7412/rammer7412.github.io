---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MistakeArchive from '@/components/MistakeArchive.astro';
import { withBase } from '@/utils/paths';

const modules = import.meta.glob('../../content/posts/*.md');
const posts = await Promise.all(Object.entries(modules).map(async ([path, load]) => {
  const mod: any = await load();
  return {
    slug: path.split('/').pop()?.replace('.md', '') ?? '',
    frontmatter: mod.frontmatter
  };
}));
const labs = posts
  .filter((post) => post.frontmatter.type === 'lab')
  .sort((a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date));
---
<BaseLayout title="Labs" description="실험 기록과 삽질 로그">
  <section class="page-head">
    <div class="container">
      <span class="badge">~/labs</span>
      <h1>실험 기록</h1>
      <p>xv6, Docker, 배포, 보안 실습처럼 직접 만지고 깨지면서 이해한 내용을 기록합니다.</p>
    </div>
  </section>
  <section class="container post-list">
    {labs.map((post) => (
      <a class="post-card" href={withBase(`/posts/${post.slug}/`)}>
        <div class="post-meta">
          <span>{post.frontmatter.date}</span>
          <span>[{post.frontmatter.category}]</span>
          {(post.frontmatter.tags ?? []).slice(0, 4).map((tag: string) => <span>#{tag}</span>)}
        </div>
        <h3>{post.frontmatter.title}</h3>
        <p>{post.frontmatter.description}</p>
      </a>
    ))}
  </section>
  <MistakeArchive />
</BaseLayout>
