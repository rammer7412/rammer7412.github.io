---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArchive from '@/components/PostArchive.astro';
import MistakeArchive from '@/components/MistakeArchive.astro';
import { getAllPosts, normalizeFormat } from '@/utils/posts';

const posts = getAllPosts().filter((post) => normalizeFormat(post.frontmatter) === 'lab');
---
<BaseLayout title="실습 기록" description="시스템, 보안, 개발 과정에서 직접 구현하고 검증한 실습 기록입니다.">
  <section class="page-hero compact">
    <div class="container page-hero-grid">
      <div><span class="eyebrow">LAB NOTES</span><h1>실습 기록</h1></div>
      <p>직접 구현하고 실패하고 검증한 과정을 남깁니다. 결과보다 문제를 좁혀간 과정과 재현 가능한 근거를 중요하게 봅니다.</p>
    </div>
  </section>
  <section class="container archive-section"><PostArchive posts={posts} showFormatFilters={false} /></section>
  <MistakeArchive />
</BaseLayout>
